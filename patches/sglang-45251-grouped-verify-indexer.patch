+    def paged_logits_args(
+        self, q, rows=slice(None), *, seq_lens=None, page_table=None
+    ):
+        """Group consecutive static-verify rows for DeepGEMM's ``next_n`` path."""
+        n = self.rows_per_request
+        q_data, q_sf = q if isinstance(q, tuple) else (q, None)
+        q_data = q_data[rows]
+        q_sf = q_sf[rows] if q_sf is not None else None
+        lens = (self.compressed_seq_lens if seq_lens is None else seq_lens)[rows]
+        table = (self.page_table if page_table is None else page_table)[rows]
+        if n > 1:
+            heads, width = q_data.shape[-2:]
+            q_data = q_data.view(-1, n, heads, width)
+            if q_sf is not None:
+                q_sf = q_sf.view(-1, n, heads)
+            lens = lens.view(-1, n)
+            table = table[::n]
+        return (q_data, q_sf) if q_sf is not None else q_data, lens, table
+
